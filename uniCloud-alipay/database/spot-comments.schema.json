{
	"bsonType": "object",
	"required": ["spot_id", "rating", "openid"],
	"permission": {
		"read": true,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"spot_id": {
			"bsonType": "string",
			"title": "地点ID",
			"description": "被评价地点 favorite-spots 的 _id"
		},
		"openid": {
			"bsonType": "string",
			"title": "用户OpenID"
		},
		"nickname": {
			"bsonType": "string",
			"title": "评价人昵称",
			"trim": "both"
		},
		"avatar": {
			"bsonType": "string",
			"title": "评价人头像"
		},
		"rating": {
			"bsonType": "int",
			"title": "评分",
			"description": "1-5 星",
			"minimum": 1,
			"maximum": 5
		},
		"content": {
			"bsonType": "string",
			"title": "评价内容",
			"trim": "both"
		},
		"create_date": {
			"bsonType": "timestamp",
			"title": "评价时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	}
}
