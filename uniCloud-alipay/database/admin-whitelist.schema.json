{
	"bsonType": "object",
	"required": ["openid"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"openid": {
			"bsonType": "string",
			"title": "管理员OpenID",
			"description": "允许进入地点管理并执行增删改的白名单"
		},
		"name": {
			"bsonType": "string",
			"title": "备注名称",
			"trim": "both"
		},
		"create_date": {
			"bsonType": "timestamp",
			"title": "创建时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	}
}
