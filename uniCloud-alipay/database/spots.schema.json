{
	"bsonType": "object",
	"required": ["name"],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": true
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"name": {
			"bsonType": "string",
			"title": "地点名称",
			"description": "收藏地点的名称",
			"trim": "both"
		},
		"type": {
			"bsonType": "string",
			"title": "地点类型",
			"description": "food-美食，view-景点，toilet-便民厕所，shop-便民商店，other-其他",
			"enum": [{
				"value": "food",
				"text": "美食"
			}, {
				"value": "view",
				"text": "景点"
			}, {
				"value": "toilet",
				"text": "便民厕所"
			}, {
				"value": "shop",
				"text": "便民商店"
			}, {
				"value": "other",
				"text": "其他"
			}],
			"defaultValue": "other"
		},
		"address": {
			"bsonType": "string",
			"title": "详细地址",
			"trim": "both"
		},
		"longitude": {
			"bsonType": "double",
			"title": "经度"
		},
		"latitude": {
			"bsonType": "double",
			"title": "纬度"
		},
		"remark": {
			"bsonType": "string",
			"title": "备注",
			"trim": "both"
		},
		"images": {
			"bsonType": "array",
			"title": "实拍图片",
			"description": "云存储图片 fileID 列表"
		},
		"status": {
			"bsonType": "string",
			"title": "审核状态",
			"description": "approved-已通过，pending-待审核，rejected-已驳回",
			"enum": [{
				"value": "approved",
				"text": "已通过"
			}, {
				"value": "pending",
				"text": "待审核"
			}, {
				"value": "rejected",
				"text": "已驳回"
			}],
			"defaultValue": "approved"
		},
		"source": {
			"bsonType": "string",
			"title": "数据来源",
			"description": "admin-管理员添加，user-用户提交",
			"enum": [{
				"value": "admin",
				"text": "管理员"
			}, {
				"value": "user",
				"text": "用户提交"
			}],
			"defaultValue": "admin"
		},
		"report_type": {
			"bsonType": "string",
			"title": "提交类型",
			"description": "new-新增地点，update-更新反馈，image-补充图片",
			"enum": [{
				"value": "new",
				"text": "新增地点"
			}, {
				"value": "update",
				"text": "更新反馈"
			}, {
				"value": "image",
				"text": "补充图片"
			}],
			"defaultValue": "new"
		},
		"report_reason": {
			"bsonType": "string",
			"title": "更新说明",
			"trim": "both"
		},
		"target_id": {
			"bsonType": "string",
			"title": "更新目标地点ID"
		},
		"contact": {
			"bsonType": "string",
			"title": "联系方式",
			"trim": "both"
		},
		"contributor_openid": {
			"bsonType": "string",
			"title": "共创者OpenID"
		},
		"contributor_name": {
			"bsonType": "string",
			"title": "共创者名称",
			"trim": "both"
		},
		"reject_reason": {
			"bsonType": "string",
			"title": "驳回原因",
			"trim": "both"
		},
		"updater_openid": {
			"bsonType": "string",
			"title": "最近修改者OpenID"
		},
		"updater_name": {
			"bsonType": "string",
			"title": "最近修改者名称",
			"trim": "both"
		},
		"create_date": {
			"bsonType": "timestamp",
			"title": "创建时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"update_date": {
			"bsonType": "timestamp",
			"title": "更新时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	}
}
