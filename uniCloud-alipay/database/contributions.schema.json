{
	"bsonType": "object",
	"required": ["openid"],
	"permission": {
		"read": false,
		"create": false,
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"openid": {
			"bsonType": "string",
			"title": "贡献者OpenID"
		},
		"name": {
			"bsonType": "string",
			"title": "贡献者名称",
			"trim": "both"
		},
		"action": {
			"bsonType": "string",
			"title": "贡献动作",
			"enum": [{
				"value": "add",
				"text": "新增地点"
			}, {
				"value": "update",
				"text": "修改地点"
			}, {
				"value": "submit",
				"text": "投稿"
			}]
		},
		"spot_id": {
			"bsonType": "string",
			"title": "地点ID"
		},
		"spot_name": {
			"bsonType": "string",
			"title": "地点名称"
		},
		"report_type": {
			"bsonType": "string",
			"title": "贡献类型",
			"enum": [{
				"value": "new",
				"text": "新增地点"
			}, {
				"value": "update",
				"text": "更新反馈"
			}]
		},
		"report_reason": {
			"bsonType": "string",
			"title": "贡献说明"
		},
		"status": {
			"bsonType": "string",
			"title": "审核状态",
			"enum": [{
				"value": "pending",
				"text": "待审核"
			}, {
				"value": "approved",
				"text": "已通过"
			}, {
				"value": "rejected",
				"text": "已驳回"
			}],
			"defaultValue": "approved"
		},
		"create_date": {
			"bsonType": "timestamp",
			"title": "贡献时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"update_date": {
			"bsonType": "timestamp",
			"title": "更新时间"
		}
	}
}
